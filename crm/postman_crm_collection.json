				{
					"name": "1.4 Demande Réinitialisation Mot de Passe (POST /api/auth/forgot-password)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"if (jsonData.resetToken) {",
									"    pm.collectionVariables.set('reset_token', jsonData.resetToken);",
									"    console.log('Reset token sauvegardé :', jsonData.resetToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
